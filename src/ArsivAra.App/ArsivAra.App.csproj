<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ArsivAra.Core\ArsivAra.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ArsivAra</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Version, product name and creator information: ../../Directory.Build.props -->
    <Title>Arşiv Ara</Title>
    <AssemblyTitle>Arşiv Ara</AssemblyTitle>
    <Description>ZIP, RAR, 7z, TAR ve ISO arşivlerinin içinde, açmadan anında arama.</Description>
    <RootNamespace>ArsivAra.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the window and taskbar icon (the exe icon comes from ApplicationIcon) -->
    <Resource Include="Assets\app.ico" />
    <!-- Logo for the empty screen and the About window. Both are generated from docs/images/logo-arsiv.svg by tools/make_icon.ps1. -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>



