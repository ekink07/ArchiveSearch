<Window x:Class="ArsivAra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArsivAra.App"
        Title="Arşiv Ara" Icon="Assets/app.ico" Height="720" Width="1180" MinWidth="780" MinHeight="460"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragEnter="Window_DragEnter" PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave" PreviewDrop="Window_Drop"
        PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Grid view: hovered / selected tile -->
        <SolidColorBrush x:Key="TileHover" Color="#1F808080" />
        <SolidColorBrush x:Key="TileSelected" Color="#40FFB300" />
        <SolidColorBrush x:Key="TileSelectedBorder" Color="#CCFFB300" />

        <!-- Icon-only buttons (the screen reader name is given via AutomationProperties.Name) -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Sortable column header -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <ContextMenu x:Key="ResultsMenu" Opened="ResultsMenu_Opened">
            <MenuItem Header="{l:T MenuOpen}" FontWeight="SemiBold" InputGestureText="Enter" Click="Open_Click" />
            <MenuItem Header="{l:T MenuShowArchive}" Click="ShowArchive_Click" />
            <MenuItem Header="{l:T MenuExtract}" InputGestureText="Ctrl+E" Click="ExtractSelected_Click" />
            <MenuItem Tag="Versions" Header="{l:T MenuVersions}" Click="Versions_Click" />
            <Separator />
            <MenuItem Header="{l:T SortBy}">
                <MenuItem Header="{l:T ColName}" Tag="Name" Click="SortMenu_Click" IsCheckable="True" />
                <MenuItem Header="{l:T ColFolder}" Tag="Folder" Click="SortMenu_Click" IsCheckable="True" />
                <MenuItem Header="{l:T ColSize}" Tag="Size" Click="SortMenu_Click" IsCheckable="True" />
                <MenuItem Header="{l:T ColModified}" Tag="Date" Click="SortMenu_Click" IsCheckable="True" />
                <MenuItem Header="{l:T ColType}" Tag="Type" Click="SortMenu_Click" IsCheckable="True" />
                <MenuItem Header="{l:T ColArchive}" Tag="Archive" Click="SortMenu_Click" IsCheckable="True" />
                <Separator />
                <MenuItem Header="{l:T SortDescending}" Tag="Descending" Click="SortMenu_Click" IsCheckable="True" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:T MenuCopyPath}" InputGestureText="Ctrl+C" Click="CopyPath_Click" />
        </ContextMenu>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}" />
        <KeyBinding Key="P" Modifiers="Alt" Command="{x:Static l:MainWindow.TogglePreviewCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{x:Static l:MainWindow.ExtractCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static l:MainWindow.SaveSearchCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{x:Static l:MainWindow.SettingsCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="FocusSearch" />
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="AddFiles_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Help}" Executed="About_Click" />
        <CommandBinding Command="{x:Static l:MainWindow.TogglePreviewCommand}" Executed="TogglePreview_Click" />
        <CommandBinding Command="{x:Static l:MainWindow.ExtractCommand}" Executed="ExtractSelected_Click" />
        <CommandBinding Command="{x:Static l:MainWindow.SaveSearchCommand}" Executed="SaveSearch_Click" />
        <CommandBinding Command="{x:Static l:MainWindow.SettingsCommand}" Executed="Settings_Click" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: logo, search, view buttons, add -->
        <Grid Grid.Row="0" Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                        Cursor="Hand" ToolTip="{l:T AboutTip}" MouseLeftButtonUp="Brand_MouseLeftButtonUp">
                <Image Source="Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.AutomationId="BrandLogo" AutomationProperties.Name="Arşiv Ara" />
                <TextBlock Text="Arşiv Ara" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox" FontSize="16" Padding="12,8" MinHeight="40"
                         VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="{l:T SearchHint}"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                <StackPanel x:Name="SearchHint" Orientation="Horizontal" IsHitTestVisible="False" Margin="15,0,0,0"
                            VerticalAlignment="Center" Opacity="0.55">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="14" />
                    <TextBlock Text="{l:T SearchHint}" FontSize="16" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="SaveSearchButton" MinHeight="40" MinWidth="40" Padding="8,6" Click="SaveSearch_Click"
                        ToolTip="{l:T SaveSearch}" AutomationProperties.AutomationId="SaveSearchButton"
                        AutomationProperties.Name="{l:T SaveSearch}">
                    <TextBlock x:Name="SaveSearchGlyph" Text="&#xE734;" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button x:Name="HelpButton" MinHeight="40" MinWidth="40" Padding="8,6" Margin="4,0,0,0" Click="Help_Click"
                        ToolTip="{l:T SearchHelp}" AutomationProperties.AutomationId="HelpButton"
                        AutomationProperties.Name="{l:T SearchHelp}">
                    <TextBlock Text="&#xE897;" Style="{StaticResource IconGlyph}" />
                </Button>
                <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="#40808080"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" MaxWidth="560">
                        <StackPanel>
                            <TextBlock Text="{l:T SearchHelp}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <TextBlock Text="{l:T SearchHelpText}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                       LineHeight="20" TextWrapping="Wrap" AutomationProperties.AutomationId="HelpText" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="ListViewButton" MinHeight="40" MinWidth="44" Padding="10,6" Margin="10,0,0,0" Click="ListView_Click"
                        ToolTip="{l:T ViewList}" AutomationProperties.AutomationId="ListViewButton"
                        AutomationProperties.Name="{l:T ViewList}">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button x:Name="GridViewButton" MinHeight="40" MinWidth="44" Padding="10,6" Margin="4,0,0,0" Click="GridView_Click"
                        ToolTip="{l:T ViewGrid}" AutomationProperties.AutomationId="GridViewButton"
                        AutomationProperties.Name="{l:T ViewGrid}">
                    <TextBlock Text="&#xE80A;" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button x:Name="PreviewButton" MinHeight="40" MinWidth="44" Padding="10,6" Margin="4,0,0,0" Click="TogglePreview_Click"
                        ToolTip="{l:T Preview}" AutomationProperties.AutomationId="PreviewButton"
                        AutomationProperties.Name="{l:T Preview}">
                    <TextBlock Text="&#xE90D;" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button x:Name="SettingsButton" MinHeight="40" MinWidth="44" Padding="10,6" Margin="4,0,0,0" Click="Settings_Click"
                        ToolTip="{l:T SettingsTip}" AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="{l:T SettingsTitle}">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button x:Name="AddButton" Margin="10,0,0,0" Padding="14,9" MinHeight="40"
                        Style="{DynamicResource AccentButtonStyle}" Click="AddFiles_Click"
                        ToolTip="{l:T AddArchivesTip}" AutomationProperties.AutomationId="AddButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="13" />
                        <TextBlock Text="{l:T AddArchives}" FontSize="14" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: archives and saved searches -->
            <Grid x:Name="Sidebar" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="4,2,4,8">
                    <Button DockPanel.Dock="Right" Padding="8,2" Click="AddFolder_Click" ToolTip="{l:T AddFolderTip}"
                            AutomationProperties.AutomationId="AddFolderButton">
                        <TextBlock Text="{l:T AddFolder}" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="ArchivesHeader" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="ArchiveList" Grid.Row="1" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="ArchiveList" AutomationProperties.Name="{l:T Archives}"
                         SelectionChanged="ArchiveList_SelectionChanged" KeyDown="ArchiveList_KeyDown"
                         MouseDoubleClick="ArchiveList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="ArchiveMenu_Opened">
                            <MenuItem Tag="Password" Header="{l:T MenuEnterPassword}" Click="EnterPassword_Click" />
                            <MenuItem Header="{l:T MenuReread}" Click="Reread_Click" />
                            <MenuItem Header="{l:T MenuShowInFolder}" Click="ShowSelectedArchive_Click" />
                            <Separator />
                            <MenuItem Header="{l:T RemoveFromList}" InputGestureText="Del" Click="RemoveSelectedArchive_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding ToolTipText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Padding="7,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="{l:T RemoveFromList}" AutomationProperties.Name="{Binding RemoveLabel}"
                                        Click="RemoveArchive_Click" Tag="{Binding Path}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="11" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="SavedSearchesPanel" Grid.Row="2" Margin="0,10,0,4" Visibility="Collapsed">
                    <TextBlock Text="{l:T SavedSearches}" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,6" />
                    <ListBox x:Name="SavedSearchList" MaxHeight="190" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="SavedSearchList" AutomationProperties.Name="{l:T SavedSearches}"
                             SelectionChanged="SavedSearchList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Query}">
                                    <Button DockPanel.Dock="Right" Padding="6,2" Background="Transparent" BorderThickness="0"
                                            ToolTip="{l:T DeleteSavedSearch}" AutomationProperties.Name="{l:T DeleteSavedSearch}"
                                            Click="DeleteSavedSearch_Click" Tag="{Binding}">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10" />
                                    </Button>
                                    <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,8,0" Opacity="0.7" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>

            <!-- Center: results (the Windows 11 theme does not support GridView, so the columns are drawn with a template) -->
            <DockPanel x:Name="ResultsPanel" Grid.Column="2">
                <Grid x:Name="ListHeader" DockPanel.Dock="Top" Margin="8,2,22,4" Opacity="0.85">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SortName" Tag="Name" Style="{StaticResource HeaderButton}" Click="SortHeader_Click"
                            AutomationProperties.AutomationId="SortName" />
                    <Button x:Name="SortFolder" Grid.Column="1" Tag="Folder" Style="{StaticResource HeaderButton}" Click="SortHeader_Click"
                            Margin="4,0,0,0" AutomationProperties.AutomationId="SortFolder" />
                    <Button x:Name="SortSize" Grid.Column="2" Tag="Size" Style="{StaticResource HeaderButton}" Click="SortHeader_Click"
                            HorizontalContentAlignment="Right" AutomationProperties.AutomationId="SortSize" />
                    <Button x:Name="SortDate" Grid.Column="3" Tag="Date" Style="{StaticResource HeaderButton}" Click="SortHeader_Click"
                            Margin="12,0,0,0" AutomationProperties.AutomationId="SortDate" />
                    <Button x:Name="SortArchive" Grid.Column="4" Tag="Archive" Style="{StaticResource HeaderButton}" Click="SortHeader_Click"
                            Margin="12,0,0,0" AutomationProperties.AutomationId="SortArchive" />
                </Grid>
                <Grid>
                    <ListBox x:Name="Results" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Item"
                             SelectionMode="Extended"
                             AutomationProperties.AutomationId="Results"
                             ContextMenu="{StaticResource ResultsMenu}"
                             MouseDoubleClick="Results_MouseDoubleClick"
                             PreviewKeyDown="Results_PreviewKeyDown"
                             SelectionChanged="Results_SelectionChanged"
                             PreviewMouseLeftButtonDown="Results_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="Results_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="Results_PreviewMouseMove">
                        <!-- The theme pads rows generously; tightened here for a dense, Everything-style list -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="10,3" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Archive}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="0,0,8,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Folder}" Margin="8,0,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" Opacity="0.75" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Margin="16,0,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding ArchiveName}" Margin="16,0,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Grid view: each item is a row of tiles; only visible rows are created -->
                    <ItemsControl x:Name="ResultsGrid" Visibility="Collapsed" Focusable="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Item"
                                  AutomationProperties.AutomationId="ResultsGrid"
                                  ContextMenu="{StaticResource ResultsMenu}"
                                  SizeChanged="ResultsGrid_SizeChanged" PreviewKeyDown="ResultsGrid_PreviewKeyDown"
                                  PreviewMouseMove="ResultsGrid_PreviewMouseMove">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding TileWidth}" Height="{Binding TileHeight}" Margin="2" CornerRadius="6"
                                                    BorderThickness="1" ToolTip="{Binding ToolTipText}" Tag="{Binding}"
                                                    MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseRightButtonDown="Tile_MouseRightButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource TileHover}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource TileSelected}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource TileSelectedBorder}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel Margin="4,8,4,4">
                                                    <Image DockPanel.Dock="Top" Source="{Binding DisplayImage}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Text="{Binding Name}" Margin="0,6,0,0" FontSize="12" TextAlignment="Center"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>

            <!-- Right: preview (Alt+P) -->
            <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Visibility="Collapsed" DragCompleted="PreviewSplitter_DragCompleted" />
            <l:PreviewPane x:Name="Preview" Grid.Column="4" Visibility="Collapsed" Margin="4,0,0,4" />

            <!-- Empty state: drop area shown when there are no archives -->
            <Border x:Name="EmptyState" Grid.Column="0" Grid.ColumnSpan="5" CornerRadius="12"
                    BorderThickness="2" BorderBrush="#808080" Background="Transparent" Margin="0,0,0,4">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <Image Source="Assets/logo.png" Width="112" Height="112" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Arşiv Ara" />
                    <TextBlock Text="{l:T EmptyTitle}" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,6" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{l:T EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Padding="16,8" Style="{DynamicResource AccentButtonStyle}" Click="AddFiles_Click"
                                AutomationProperties.AutomationId="EmptyPickFiles">
                            <TextBlock Text="{l:T EmptyPickFiles}" FontSize="14" />
                        </Button>
                        <Button Padding="16,8" Margin="10,0,0,0" Click="AddFolder_Click" AutomationProperties.AutomationId="EmptyPickFolder">
                            <TextBlock Text="{l:T EmptyPickFolder}" FontSize="14" />
                        </Button>
                        <Button Padding="16,8" Margin="10,0,0,0" Click="EmptyScanDisks_Click" AutomationProperties.AutomationId="EmptyScanDisks">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource IconGlyph}" FontSize="14" />
                                <TextBlock Text="{l:T EmptyScanDisks}" FontSize="14" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom status bar -->
        <Grid Grid.Row="2" Margin="18,8,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Progress bar shown while archives are being added or disks scanned -->
            <StackPanel x:Name="AddProgressPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0" VerticalAlignment="Center">
                <ProgressBar x:Name="AddProgressBar" Width="200" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                <TextBlock x:Name="AddProgressText" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="LibraryStatus" Grid.Column="1" Opacity="0.7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="LibraryStatus" />
            <TextBlock x:Name="ResultStatus" Grid.Column="2" Margin="16,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="ResultStatus" />
            <!-- Author credit: clicking it (or F1) opens the About window; it can also be reached with the keyboard -->
            <TextBlock Grid.Column="3" Margin="20,0,0,0" FontSize="12" Opacity="0.6" VerticalAlignment="Center">
                <Hyperlink x:Name="CreditLink" Click="About_Click" TextDecorations="{x:Null}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                           ToolTip="{l:T AboutTip}" AutomationProperties.AutomationId="CreditLink"
                           AutomationProperties.Name="Created By MaledictusMaggot®">
                    <Run Text="Created By" /> <Run Text="MaledictusMaggot®" FontWeight="SemiBold" />
                </Hyperlink>
            </TextBlock>
        </Grid>

        <!-- Overlay covering the whole window during a drag -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#D90F304C" CornerRadius="12" Margin="8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="Assets/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{l:T DropHere}" FontSize="26" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
