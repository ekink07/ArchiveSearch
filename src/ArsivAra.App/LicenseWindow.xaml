<Window x:Class="ArsivAra.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArsivAra.App"
        Title="{l:T LicenseTitle}" Icon="Assets/app.ico"
        Width="680" Height="600" MinWidth="440" MinHeight="340" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Top">
            <Image Source="Assets/logo.png" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Arşiv Ara" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="SubText" Opacity="0.75" AutomationProperties.AutomationId="LicenseSubtitle" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{l:T LicenseSummary}" TextWrapping="Wrap" Margin="0,14,0,0" />
        <Button DockPanel.Dock="Bottom" Content="{l:T Close}" IsDefault="True" IsCancel="True" MinWidth="104" Padding="16,6"
                HorizontalAlignment="Right" Margin="0,16,0,0" Style="{DynamicResource AccentButtonStyle}"
                AutomationProperties.AutomationId="LicenseClose" />
        <!-- Texts shown as-is (English legal text); they can be selected and copied -->
        <TabControl Margin="0,14,0,0">
            <TabItem Header="{l:T LicenseProgram}" AutomationProperties.AutomationId="LicenseTab">
                <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8"
                         AutomationProperties.AutomationId="LicenseText" AutomationProperties.Name="{l:T LicenseProgram}" />
            </TabItem>
            <TabItem Header="{l:T LicenseComponents}" AutomationProperties.AutomationId="NoticesTab">
                <TextBox x:Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8"
                         AutomationProperties.AutomationId="NoticesText" AutomationProperties.Name="{l:T LicenseComponents}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
