<Window x:Class="ArsivAra.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArsivAra.App"
        Title="{l:T SettingsTitle}" Icon="Assets/app.ico"
        Width="600" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <!-- Folder lists: compact rows, long paths are shortened with "…" (full path in the tooltip) -->
        <Style x:Key="PathList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Height" Value="110" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Margin" Value="2,1" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,20">
            <TextBlock Text="{l:T SetLanguage}" Style="{StaticResource Section}" />
            <ComboBox x:Name="LanguageBox" MinWidth="220" HorizontalAlignment="Left" SelectionChanged="Language_Changed"
                      AutomationProperties.AutomationId="LanguageBox" AutomationProperties.Name="{l:T SetLanguage}" />

            <TextBlock Text="{l:T SetScanHeader}" Style="{StaticResource Section}" />
            <CheckBox x:Name="ScanDisksBox" Content="{l:T SetScanDisks}" AutomationProperties.AutomationId="ScanDisksBox" />
            <CheckBox x:Name="FastScanBox" Content="{l:T SetFastScan}" Margin="0,6,0,0" AutomationProperties.AutomationId="FastScanBox"
                      IsEnabled="{Binding IsChecked, ElementName=ScanDisksBox}" />
            <Grid Margin="0,12,0,0" IsEnabled="{Binding IsChecked, ElementName=ScanDisksBox}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T SetRoots}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,4" />
                    <ListBox x:Name="RootsList" Style="{StaticResource PathList}"
                             AutomationProperties.AutomationId="RootsList" AutomationProperties.Name="{l:T SetRoots}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{l:T SetAdd}" Click="AddRoot_Click" MinWidth="80" />
                        <Button Content="{l:T SetRemove}" Click="RemoveRoot_Click" MinWidth="80" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T SetExcludes}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,4" />
                    <ListBox x:Name="ExcludesList" Style="{StaticResource PathList}"
                             AutomationProperties.AutomationId="ExcludesList" AutomationProperties.Name="{l:T SetExcludes}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{l:T SetAdd}" Click="AddExclude_Click" MinWidth="80" />
                        <Button Content="{l:T SetRemove}" Click="RemoveExclude_Click" MinWidth="80" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Button Content="{l:T SetScanNow}" Click="ScanNow_Click" HorizontalAlignment="Left" Margin="0,10,0,0" MinWidth="120"
                    IsEnabled="{Binding IsChecked, ElementName=ScanDisksBox}" AutomationProperties.AutomationId="ScanNowButton" />

            <TextBlock Text="{l:T Archives}" Style="{StaticResource Section}" />
            <CheckBox x:Name="NestedBox" Content="{l:T SetReadNested}" AutomationProperties.AutomationId="NestedBox" />

            <TextBlock Text="{l:T SetPrivacyHeader}" Style="{StaticResource Section}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T SetTempKeep}" VerticalAlignment="Center" />
                <ComboBox x:Name="TempDaysBox" MinWidth="110" Margin="10,0,0,0" AutomationProperties.Name="{l:T SetTempKeep}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="TempSizeText" VerticalAlignment="Center" MinWidth="160" />
                <Button Content="{l:T SetTempClean}" Click="CleanTemp_Click" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="PasswordsText" VerticalAlignment="Center" MinWidth="160" />
                <Button x:Name="ClearPasswordsButton" Content="{l:T SetPasswordsClear}" Click="ClearPasswords_Click" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="DataDirText" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0" />
            <Button Content="{l:T SetOpenLogs}" Click="OpenLogs_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />

            <DockPanel Margin="0,22,0,0">
                <Button Content="{l:T SetAboutLicense}" Click="About_Click" DockPanel.Dock="Left"
                        AutomationProperties.AutomationId="SettingsAbout" />
                <Button Content="{l:T Close}" Click="Close_Click" HorizontalAlignment="Right"
                        MinWidth="110" Style="{DynamicResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="SettingsClose" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
