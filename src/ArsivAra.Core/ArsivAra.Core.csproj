<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testler iç (internal) ayrıştırıcıları ve yolları doğrudan dener -->
    <InternalsVisibleTo Include="ArsivAra.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lisans penceresi ve "ArsivAra.Cli lisans" bu metinleri gösterir; ayrı dosya dağıtmaya gerek kalmaz -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" Link="LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

</Project>


