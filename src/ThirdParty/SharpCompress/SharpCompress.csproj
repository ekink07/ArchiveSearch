<Project Sdk="Microsoft.NET.Sdk">

  <!-- SharpCompress 0.50.4 as source code (github.com/adamhathcock/sharpcompress, commit c083c6e).
       Origin and update steps: ../README.md. Licenses: ../../../THIRD-PARTY-NOTICES.txt -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SharpCompress</AssemblyName>
    <RootNamespace>SharpCompress</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Third-party code: warnings and code analyzers are off in this project -->
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Keep the Arşiv Ara details from the root Directory.Build.props out of this assembly -->
    <Version>0.50.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>SharpCompress</Product>
    <AssemblyTitle>SharpCompress - Pure C# Decompression/Compression</AssemblyTitle>
    <Authors>Adam Hathcock</Authors>
    <Company>Adam Hathcock</Company>
    <Copyright>Copyright (c) 2014 Adam Hathcock</Copyright>
    <Description>SharpCompress 0.50.4 source, compiled as part of Arşiv Ara. MIT License; see THIRD-PARTY-NOTICES.txt.</Description>
  </PropertyGroup>

</Project>
