<Window x:Class="ArsivAra.App.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArsivAra.App"
        Title="{l:T PasswordTitle}" Icon="Assets/app.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="24,20,24,20">
        <DockPanel>
            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <PasswordBox x:Name="Box" Margin="0,14,0,0" MinHeight="34"
                     AutomationProperties.AutomationId="PasswordBox" AutomationProperties.Name="{l:T PasswordTitle}" />
        <TextBlock x:Name="WrongText" Text="{l:T PasswordWrong}" Foreground="#E0484E" Margin="0,8,0,0" Visibility="Collapsed" />
        <CheckBox x:Name="RememberBox" Content="{l:T PasswordRemember}" Margin="0,14,0,0" AutomationProperties.AutomationId="PasswordRemember" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:T OK}" IsDefault="True" MinWidth="96" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="PasswordOk" />
            <Button Content="{l:T Cancel}" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
