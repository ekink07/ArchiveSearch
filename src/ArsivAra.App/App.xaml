<Application x:Class="ArsivAra.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System" ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Icon font: Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10 -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
