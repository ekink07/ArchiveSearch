<Window x:Class="ArsivAra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arşiv Ara" Icon="Assets/app.ico" Height="720" Width="1180" MinWidth="720" MinHeight="420"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragEnter="Window_DragEnter" PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave" PreviewDrop="Window_Drop"
        PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Kareli görünümde üzerine gelme / seçili kare -->
        <SolidColorBrush x:Key="TileHover" Color="#1F808080" />
        <SolidColorBrush x:Key="TileSelected" Color="#40FFB300" />
        <SolidColorBrush x:Key="TileSelectedBorder" Color="#CCFFB300" />
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="FocusSearch" />
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="AddFiles_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Help}" Executed="About_Click" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst çubuk: arama + ekle -->
        <Grid Grid.Row="0" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Görünüm: liste / kareler (Ctrl+tekerlek ile de değişir) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button x:Name="ListViewButton" MinHeight="40" MinWidth="44" Padding="10,6" Click="ListView_Click"
                        ToolTip="Liste görünümü (Ctrl+tekerlek ile simge boyutu)">
                    <TextBlock Text="☰" FontSize="16" />
                </Button>
                <Button x:Name="GridViewButton" MinHeight="40" MinWidth="44" Padding="10,6" Margin="4,0,0,0" Click="GridView_Click"
                        ToolTip="Kareli görünüm (Ctrl+tekerlek ile büyüt/küçült)">
                    <TextBlock Text="▦" FontSize="16" />
                </Button>
            </StackPanel>
            <Grid>
                <TextBox x:Name="SearchBox" FontSize="16" Padding="12,8" MinHeight="40"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                <TextBlock x:Name="SearchHint" Text="🔍  Arşivlerin içinde ara…" IsHitTestVisible="False"
                           Margin="16,0,0,0" VerticalAlignment="Center" FontSize="16" Opacity="0.55" />
            </Grid>
            <Button Grid.Column="2" Margin="10,0,0,0" Padding="16,9" MinHeight="40"
                    Style="{DynamicResource AccentButtonStyle}" Click="AddFiles_Click"
                    ToolTip="RAR, ZIP, 7z dosyalarını ekle (Ctrl+O)">
                <TextBlock Text="＋  Arşiv ekle" FontSize="14" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol: eklenen arşivler -->
            <DockPanel x:Name="Sidebar" Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,8">
                    <Button DockPanel.Dock="Right" Padding="8,2" Click="AddFolder_Click" ToolTip="Bir klasördeki tüm arşivleri ekle">
                        <TextBlock Text="Klasör ekle" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="ArchivesHeader" Text="Arşivler" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="ArchiveList" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ArchiveList_SelectionChanged" KeyDown="ArchiveList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" ToolTip="{Binding Path}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="✕" Padding="7,2" Margin="6,0,0,0" FontSize="11"
                                        VerticalAlignment="Center" ToolTip="Listeden kaldır" Background="Transparent" BorderThickness="0"
                                        Click="RemoveArchive_Click" Tag="{Binding Path}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Sağ: sonuçlar (Windows 11 teması GridView desteklemediği için sütunlar şablonla çiziliyor) -->
            <DockPanel x:Name="ResultsPanel" Grid.Column="2">
                <Grid x:Name="ListHeader" DockPanel.Dock="Top" Margin="12,4,26,6" TextElement.FontWeight="SemiBold" Opacity="0.75">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ad" />
                    <TextBlock Grid.Column="1" Text="Arşiv içindeki klasör" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="Boyut" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Arşiv" Margin="16,0,0,0" />
                </Grid>
                <Grid>
                <ListBox x:Name="Results" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item"
                         SelectionMode="Extended"
                         MouseDoubleClick="Results_MouseDoubleClick"
                         PreviewKeyDown="Results_PreviewKeyDown">
                    <!-- Tema satırlara geniş boşluk veriyor; Everything gibi sık liste için daraltılıyor -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="10,3" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Aç" FontWeight="SemiBold" Click="Open_Click" />
                            <MenuItem Header="Arşivi klasörde göster" Click="ShowArchive_Click" />
                            <Separator />
                            <MenuItem Header="Yolu kopyala" InputGestureText="Ctrl+C" Click="CopyPath_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Archive}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="0,0,8,0"
                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Folder}" Margin="8,0,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" Opacity="0.75" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding ArchiveName}" Margin="16,0,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Kareli görünüm: her öğe bir satır dolusu kare; sadece görünen satırlar oluşturulur -->
                <ItemsControl x:Name="ResultsGrid" Visibility="Collapsed" Focusable="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item"
                              SizeChanged="ResultsGrid_SizeChanged" PreviewKeyDown="ResultsGrid_PreviewKeyDown">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Aç" FontWeight="SemiBold" Click="Open_Click" />
                            <MenuItem Header="Arşivi klasörde göster" Click="ShowArchive_Click" />
                            <Separator />
                            <MenuItem Header="Yolu kopyala" InputGestureText="Ctrl+C" Click="CopyPath_Click" />
                        </ContextMenu>
                    </ItemsControl.ContextMenu>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding TileWidth}" Height="{Binding TileHeight}" Margin="2" CornerRadius="6"
                                                BorderThickness="1" ToolTip="{Binding ToolTipText}" Tag="{Binding}"
                                                MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseRightButtonDown="Tile_MouseRightButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TileHover}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TileSelected}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource TileSelectedBorder}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel Margin="4,8,4,4">
                                                <Image DockPanel.Dock="Top" Source="{Binding DisplayImage}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Name}" Margin="0,6,0,0" FontSize="12" TextAlignment="Center"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </DockPanel>

            <!-- Boş durum: hiç arşiv yokken bırakma alanı -->
            <Border x:Name="EmptyState" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="12"
                    BorderThickness="2" BorderBrush="#808080" Background="Transparent" Margin="0,0,0,4">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <Image Source="Assets/logo.png" Width="112" Height="112" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Arşivleri buraya sürükleyip bırakın" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,6" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"
                               Text="RAR, ZIP, 7z ve TAR dosyalarının içindeki her dosya adı aranabilir hâle gelir. Bir klasör bırakırsanız içindeki tüm arşivler eklenir." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Padding="16,8" Style="{DynamicResource AccentButtonStyle}" Click="AddFiles_Click">
                            <TextBlock Text="Dosya seç" FontSize="14" />
                        </Button>
                        <Button Padding="16,8" Margin="10,0,0,0" Click="AddFolder_Click">
                            <TextBlock Text="Klasör seç" FontSize="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Alt durum satırı -->
        <Grid Grid.Row="2" Margin="18,8,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Arşiv eklenirken görünen ilerleme çubuğu -->
            <StackPanel x:Name="AddProgressPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0" VerticalAlignment="Center">
                <ProgressBar x:Name="AddProgressBar" Width="200" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                <TextBlock x:Name="AddProgressText" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="LibraryStatus" Grid.Column="1" Opacity="0.7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="ResultStatus" Grid.Column="2" Margin="16,0,0,0" Opacity="0.7" VerticalAlignment="Center" />
            <!-- Yapımcı imzası: tıklayınca (ya da F1) Hakkında penceresi açılır -->
            <TextBlock Grid.Column="3" Margin="20,0,0,0" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                       Cursor="Hand" ToolTip="Arşiv Ara hakkında (F1)" MouseLeftButtonUp="About_Click">
                <Run Text="Created By" /> <Run Text="MaledictusMaggot®" FontWeight="SemiBold" />
            </TextBlock>
        </Grid>

        <!-- Sürüklerken tüm pencereyi kaplayan katman -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#CC1A73E8" CornerRadius="12" Margin="8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📥" FontSize="56" HorizontalAlignment="Center" Foreground="White" />
                <TextBlock Text="Bırakın, eklensin" FontSize="26" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>



