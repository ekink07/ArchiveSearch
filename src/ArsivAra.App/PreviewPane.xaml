<UserControl x:Class="ArsivAra.App.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ArsivAra.App"
             AutomationProperties.AutomationId="PreviewPane" AutomationProperties.Name="{l:T PreviewTitle}">
    <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="8" Padding="14,12" Background="#0A808080">
        <DockPanel>
            <StackPanel x:Name="Header" DockPanel.Dock="Top" Visibility="Collapsed">
                <DockPanel>
                    <Image x:Name="IconImage" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="TitleText" AutomationProperties.AutomationId="PreviewTitle" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:T ColSize}" Opacity="0.65" Margin="0,0,12,3" />
                    <TextBlock x:Name="SizeText" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="1" Text="{l:T ColModified}" Opacity="0.65" Margin="0,0,12,3" />
                    <TextBlock x:Name="ModifiedText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="2" Text="{l:T ColFolder}" Opacity="0.65" Margin="0,0,12,3" />
                    <TextBlock x:Name="FolderText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="3" Text="{l:T ColArchive}" Opacity="0.65" Margin="0,0,12,3" />
                    <TextBlock x:Name="ArchiveText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="OpenButton" Content="{l:T MenuOpen}" MinWidth="80" Click="Open_Click"
                            Style="{DynamicResource AccentButtonStyle}" AutomationProperties.AutomationId="PreviewOpen" />
                    <Button Content="{l:T PreviewExtract}" MinWidth="80" Margin="8,0,0,0" Click="Extract_Click"
                            AutomationProperties.AutomationId="PreviewExtract" />
                </StackPanel>
                <StackPanel x:Name="VersionsPanel" Margin="0,14,0,0">
                    <TextBlock Text="{l:T PreviewVersions}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl x:Name="VersionsList" AutomationProperties.AutomationId="PreviewVersions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" ToolTip="{Binding ToolTip}" TextTrimming="CharacterEllipsis" Margin="0,1"
                                           FontWeight="{Binding Weight}" Opacity="{Binding Opacity}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            <Grid Margin="0,12,0,0">
                <Image x:Name="ImageView" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                <TextBox x:Name="TextView" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Visibility="Collapsed"
                         AutomationProperties.AutomationId="PreviewText" />
                <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="MessageText" AutomationProperties.AutomationId="PreviewMessage" TextWrapping="Wrap"
                               TextAlignment="Center" Opacity="0.65" MaxWidth="280" />
                    <Button x:Name="LoadAnywayButton" Content="{l:T PreviewLoadAnyway}" Click="LoadAnyway_Click"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
