<Window x:Class="ArsivAra.App.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArsivAra.App"
        Icon="Assets/app.ico" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="Input" Margin="0,12,0,0" MinHeight="34" AutomationProperties.AutomationId="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:T OK}" IsDefault="True" MinWidth="96" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="InputOk" />
            <Button Content="{l:T Cancel}" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
